rules_version = '2';

/**
 * Personal Finance — Security Rules (Fase 2)
 *
 * Princípios:
 *  - Negação padrão: nada é acessível sem regra explícita.
 *  - Isolamento total por usuário: todo caminho exige request.auth.uid == userId.
 *  - Campos fechados: cada coleção lista os campos permitidos e os obrigatórios.
 *  - Dinheiro em centavos inteiros (is int, >= 0; movimentações > 0).
 *  - Datas como timestamp; createdAt/updatedAt só pelo servidor.
 *  - auditLog: create-only (sem update/delete) — nem o administrador altera ou apaga auditoria.
 *  - Administrador (VF-2-03w): custom claim `admin == true` (definido SÓ pelo Admin SDK/Console — o cliente não
 *    consegue se auto-promover). Poderes MÍNIMOS: LER e APAGAR documentos das coleções de DOMÍNIO de qualquer uid
 *    (para limpeza administrativa sem entrar na conta do usuário). Não cria, não edita, não toca perfil,
 *    configurações nem auditLog. Usuário comum continua restrito ao próprio uid.
 *  - Referências: IDs de documentos da própria árvore do usuário, validados com exists().
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers globais ----------
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Administrador: claim de token definida pelo Admin SDK (`setCustomUserClaims(uid, { admin: true })`).
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function data() {
      return request.resource.data;
    }

    function keysOk(allowed) {
      return data().keys().hasOnly(allowed);
    }

    function requiredOk(required) {
      return data().keys().hasAll(required);
    }

    function cents(value) {
      return value is int && value >= 0;
    }

    function positiveCents(value) {
      return value is int && value > 0;
    }

    function stamp(value) {
      return value is timestamp;
    }

    function optionalStamp(field) {
      return !(field in data()) || data()[field] is timestamp;
    }

    function optionalString(field, maxLen) {
      return !(field in data()) || (data()[field] is string && data()[field].size() <= maxLen);
    }

    function optionalBool(field) {
      return !(field in data()) || data()[field] is bool;
    }

    function text(field, maxLen) {
      return data()[field] is string
        && data()[field].size() > 0
        && data()[field].size() <= maxLen;
    }

    function oneOf(field, allowed) {
      return data()[field] is string && data()[field] in allowed;
    }

    function timestampsOk() {
      return data().createdAt == request.time && data().updatedAt == request.time;
    }

    function immutable(name) {
      return data()[name] == resource.data[name];
    }

    // Referência a documento da própria árvore: string ID + existência real.
    function ref(userId, collectionName, field) {
      return data()[field] is string
        && data()[field].size() > 0
        && data()[field].size() <= 128
        && exists(/databases/$(database)/documents/users/$(userId)/$(collectionName)/$(data()[field]));
    }

    function optionalRef(userId, collectionName, field) {
      return !(field in data()) || ref(userId, collectionName, field);
    }

    // Caminho de um documento da árvore do usuário (para get/getAfter/exists).
    function docPath(userId, collectionName, id) {
      return /databases/$(database)/documents/users/$(userId)/$(collectionName)/$(id);
    }

    // ---------- raiz do usuário ----------
    match /users/{userId} {
      allow read, write: if false;
    }

    // ---------- perfil (documento único) ----------
    match /users/{userId}/profile/{docId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && docId == 'main'
        && keysOk(['name', 'email', 'currency', 'locale', 'createdAt', 'updatedAt'])
        && requiredOk(['name', 'email', 'currency', 'locale', 'createdAt', 'updatedAt'])
        && text('name', 80)
        && text('email', 160)
        && data().currency == 'BRL'
        && data().locale == 'pt-BR'
        && timestampsOk();
      allow update: if isOwner(userId)
        && docId == 'main'
        && keysOk(['name', 'email', 'currency', 'locale', 'createdAt', 'updatedAt'])
        && requiredOk(['name', 'email', 'currency', 'locale', 'createdAt', 'updatedAt'])
        && text('name', 80)
        && text('email', 160)
        && data().currency == 'BRL'
        && data().locale == 'pt-BR'
        && immutable('createdAt')
        && data().updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- configurações (documento único) ----------
    match /users/{userId}/settings/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && docId == 'main'
        && keysOk(['theme', 'hideValues', 'firstWeekday', 'createdAt', 'updatedAt'])
        && requiredOk(['theme', 'createdAt', 'updatedAt'])
        && oneOf('theme', ['light', 'dark', 'system'])
        && optionalBool('hideValues')
        && (!('firstWeekday' in data()) || (data().firstWeekday is int && data().firstWeekday >= 0 && data().firstWeekday <= 6))
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      allow delete: if false;
    }

    // ---------- contas ----------
    match /users/{userId}/accounts/{accountId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['institution', 'name', 'type', 'initialBalanceCents', 'openingDate', 'color', 'status', 'ledgerSeq', 'createdAt', 'updatedAt'])
        && requiredOk(['institution', 'type', 'initialBalanceCents', 'color', 'status', 'createdAt', 'updatedAt'])
        && text('institution', 80)
        && (!('name' in data()) || text('name', 80))
        && optionalStamp('openingDate')
        && oneOf('type', ['checking', 'salary', 'savings', 'digital', 'investment', 'benefit', 'other'])
        && cents(data().initialBalanceCents)
        && text('color', 32)
        && oneOf('status', ['active', 'inactive', 'archived'])
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'))
        // Saldo de abertura, data de abertura e `ledgerSeq` só mudam pela camada confiável (op account.adjustOpening);
        // `ledgerSeq` não nasce do cliente.
        && (resource == null || (data().initialBalanceCents == resource.data.initialBalanceCents
              && data().get('openingDate', null) == resource.data.get('openingDate', null)
              && data().get('ledgerSeq', 0) == resource.data.get('ledgerSeq', 0)))
        && (resource != null || !('ledgerSeq' in data()));
      // Conta não é apagada pelo cliente (histórico): arquive/apague pelo servidor (op account.delete/archive).
      allow delete: if isAdmin();
    }

    // ---------- categorias ----------
    match /users/{userId}/categories/{categoryId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['name', 'kind', 'color', 'createdAt', 'updatedAt'])
        && requiredOk(['name', 'kind', 'color', 'createdAt', 'updatedAt'])
        && text('name', 60)
        && oneOf('kind', ['income', 'expense', 'both'])
        && text('color', 32)
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------- receitas ----------
    match /users/{userId}/incomes/{incomeId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['description', 'categoryId', 'amountCents', 'expectedDate', 'receivedDate',
                   'accountId', 'status', 'recurrence', 'notes', 'operationId', 'createdAt', 'updatedAt'])
        && requiredOk(['description', 'categoryId', 'amountCents', 'expectedDate',
                       'accountId', 'status', 'recurrence', 'createdAt', 'updatedAt'])
        && text('description', 120)
        && positiveCents(data().amountCents)
        && stamp(data().expectedDate)
        && optionalStamp('receivedDate')
        && ref(userId, 'categories', 'categoryId')
        && ref(userId, 'accounts', 'accountId')
        && oneOf('status', ['pending', 'received', 'cancelled'])
        && oneOf('recurrence', ['none', 'monthly', 'weekly', 'yearly'])
        && optionalString('notes', 500)
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'))
        // VF-ARQ-02: movimentos que alteram saldo só são gravados pela camada confiável (Admin SDK ignora estas Rules).
        && data().status != 'received'
        && (resource == null || resource.data.status != 'received');
      // Original já ESTORNADO (reversals/incomes_<id>) é histórico: não é apagado pelo dono.
      allow delete: if isAdmin() || (isOwner(userId) && resource.data.status != 'received'
        && !exists(docPath(userId, 'reversals', 'incomes_' + incomeId)));
    }

    // ---------- despesas ----------
    match /users/{userId}/expenses/{expenseId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['description', 'categoryId', 'amountCents', 'accountId', 'purchaseDate',
                   'dueDate', 'paidDate', 'status', 'recurrence', 'notes',
                   'installmentGroupId', 'operationId', 'createdAt', 'updatedAt'])
        && requiredOk(['description', 'categoryId', 'amountCents', 'accountId',
                       'purchaseDate', 'dueDate', 'status', 'recurrence', 'createdAt', 'updatedAt'])
        && text('description', 120)
        && positiveCents(data().amountCents)
        && stamp(data().purchaseDate)
        && stamp(data().dueDate)
        && optionalStamp('paidDate')
        && ref(userId, 'categories', 'categoryId')
        && ref(userId, 'accounts', 'accountId')
        && oneOf('status', ['pending', 'paid', 'cancelled'])
        && oneOf('recurrence', ['none', 'monthly', 'weekly', 'yearly'])
        && optionalString('notes', 500)
        && optionalString('installmentGroupId', 128)
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'))
        // VF-ARQ-02: movimentos que alteram saldo só são gravados pela camada confiável (Admin SDK ignora estas Rules).
        && data().status != 'paid'
        && (resource == null || resource.data.status != 'paid');
      // Original já ESTORNADO (reversals/expenses_<id>) é histórico: não é apagado pelo dono.
      allow delete: if isAdmin() || (isOwner(userId) && resource.data.status != 'paid'
        && !exists(docPath(userId, 'reversals', 'expenses_' + expenseId)));
    }

    // ---------- transferências ----------
    match /users/{userId}/transfers/{transferId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['fromAccountId', 'toAccountId', 'amountCents', 'date', 'reason',
                   'notes', 'status', 'operationId', 'createdAt', 'updatedAt'])
        && requiredOk(['fromAccountId', 'toAccountId', 'amountCents', 'date',
                       'reason', 'status', 'createdAt', 'updatedAt'])
        && data().fromAccountId != data().toAccountId
        && ref(userId, 'accounts', 'fromAccountId')
        && ref(userId, 'accounts', 'toAccountId')
        && positiveCents(data().amountCents)
        && stamp(data().date)
        && text('reason', 120)
        && optionalString('notes', 500)
        && oneOf('status', ['pending', 'confirmed', 'cancelled'])
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'))
        // VF-ARQ-02: movimentos que alteram saldo só são gravados pela camada confiável (Admin SDK ignora estas Rules).
        && data().status != 'confirmed'
        && (resource == null || resource.data.status != 'confirmed');
      // Original já ESTORNADO (reversals/transfers_<id>) é histórico: não é apagado pelo dono.
      allow delete: if isAdmin() || (isOwner(userId) && resource.data.status != 'confirmed'
        && !exists(docPath(userId, 'reversals', 'transfers_' + transferId)));
    }

    // ---------- assinaturas ----------
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['name', 'amountCents', 'periodicity', 'nextChargeDate', 'chargeDay', 'accountId',
                   'cardId', 'debtorId', 'categoryId', 'status', 'notes', 'createdAt', 'updatedAt'])
        && requiredOk(['name', 'amountCents', 'periodicity', 'nextChargeDate',
                       'categoryId', 'status', 'createdAt', 'updatedAt'])
        && text('name', 80)
        && positiveCents(data().amountCents)
        && oneOf('periodicity', ['monthly', 'weekly', 'yearly'])
        && stamp(data().nextChargeDate)
        && (!('chargeDay' in data()) || (data().chargeDay is int && data().chargeDay >= 1 && data().chargeDay <= 31))
        && optionalRef(userId, 'accounts', 'accountId')
        && optionalRef(userId, 'creditCards', 'cardId')
        && optionalRef(userId, 'debtors', 'debtorId')
        && ref(userId, 'categories', 'categoryId')
        && oneOf('status', ['active', 'paused', 'cancelled'])
        && optionalString('notes', 500)
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------- devedores ----------
    match /users/{userId}/debtors/{debtorId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['name', 'loanDate', 'lentCents', 'receivedCents', 'status', 'notes', 'archived',
                   'createdAt', 'updatedAt'])
        && requiredOk(['name', 'loanDate', 'lentCents', 'receivedCents', 'status',
                       'createdAt', 'updatedAt'])
        && text('name', 80)
        && stamp(data().loanDate)
        && cents(data().lentCents)
        && cents(data().receivedCents)
        && data().receivedCents <= data().lentCents
        && (resource == null || data().receivedCents >= resource.data.receivedCents)
        && oneOf('status', ['open', 'paid', 'cancelled'])
        && optionalString('notes', 500)
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'))
        // VF-ARQ-02: o total recebido, o status `paid` e o arquivamento só mudam pela camada confiável.
        && (resource == null ? data().receivedCents == 0 : data().receivedCents == resource.data.receivedCents)
        && (data().status != 'paid' || (resource != null && resource.data.status == 'paid'))
        && (resource == null ? !('archived' in data()) : data().get('archived', false) == resource.data.get('archived', false));
      // Devedor não é apagado pelo cliente (histórico de dívidas/recebimentos): op debtor.archive / debtor.delete.
      allow delete: if isAdmin();
    }

    // ---------- dívidas (parcelas) ----------
    match /users/{userId}/debts/{debtId} {
      allow read: if isOwner(userId) || isAdmin();
      // VF-ARQ-02: o cliente cria parcelas (plano de dívida) sempre `pending`; pagar/cancelar é do servidor.
      allow create: if isOwner(userId)
        && data().status == 'pending'
        && keysOk(['debtorId', 'description', 'principalCents', 'dueDate',
                   'installmentNumber', 'installmentsTotal', 'debtGroupId', 'status',
                   'createdAt', 'updatedAt'])
        && requiredOk(['debtorId', 'description', 'principalCents', 'dueDate',
                       'installmentNumber', 'status', 'createdAt', 'updatedAt'])
        && ref(userId, 'debtors', 'debtorId')
        && text('description', 120)
        && positiveCents(data().principalCents)
        && stamp(data().dueDate)
        && data().installmentNumber is int
        && data().installmentNumber > 0
        && data().installmentNumber <= 360
        && (!('installmentsTotal' in data())
            || (data().installmentsTotal is int
                && data().installmentsTotal >= data().installmentNumber
                && data().installmentsTotal <= 360))
        && optionalString('debtGroupId', 128)
        && oneOf('status', ['pending', 'paid', 'late', 'cancelled'])
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- recebimentos de dívidas ----------
    match /users/{userId}/debtPayments/{paymentId} {
      allow read: if isOwner(userId) || isAdmin();
      // VF-ARQ-02: recebimentos só são gravados pela camada confiável (op debt.receive / debt.settleBatch), que valida o
      // valor máximo por parcela e por devedor dentro de uma transação. O cliente só lê. Histórico imutável: correção =
      // estorno (op reversal.create). Exclusão só do administrador.
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ---------- metas ----------
    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['name', 'description', 'targetCents', 'deadline', 'accountId',
                   'status', 'createdAt', 'updatedAt'])
        && requiredOk(['name', 'targetCents', 'status', 'createdAt', 'updatedAt'])
        && text('name', 80)
        && optionalString('description', 300)
        && positiveCents(data().targetCents)
        && optionalStamp('deadline')
        && optionalRef(userId, 'accounts', 'accountId')
        && oneOf('status', ['active', 'completed', 'cancelled'])
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------- movimentações de metas ----------
    match /users/{userId}/goalTransactions/{transactionId} {
      allow read: if isOwner(userId) || isAdmin();
      // VF-ARQ-02: aportes/resgates só são gravados pela camada confiável (op goal.deposit/withdraw); o cliente só lê.
      // O histórico é imutável: correção = estorno (op reversal.create). Exclusão só do administrador.
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ---------- cartões ----------
    match /users/{userId}/creditCards/{cardId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['name', 'brand', 'limitCents', 'closingDay', 'dueDay', 'accountId',
                   'color', 'status', 'createdAt', 'updatedAt'])
        && requiredOk(['name', 'brand', 'limitCents', 'closingDay', 'dueDay',
                       'status', 'createdAt', 'updatedAt'])
        && text('name', 80)
        && text('brand', 40)
        && positiveCents(data().limitCents)
        && data().closingDay is int && data().closingDay >= 1 && data().closingDay <= 31
        && data().dueDay is int && data().dueDay >= 1 && data().dueDay <= 31
        && optionalRef(userId, 'accounts', 'accountId')
        && optionalString('color', 32)
        && oneOf('status', ['active', 'blocked', 'cancelled'])
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------- compras no cartão ----------
    match /users/{userId}/cardPurchases/{purchaseId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && keysOk(['cardId', 'description', 'amountCents', 'purchaseDate', 'installmentsTotal',
                   'installmentNumber', 'categoryId', 'invoiceId', 'debtorId', 'notes',
                   'createdAt', 'updatedAt'])
        && requiredOk(['cardId', 'description', 'amountCents', 'purchaseDate',
                       'installmentsTotal', 'installmentNumber', 'createdAt', 'updatedAt'])
        && ref(userId, 'creditCards', 'cardId')
        && text('description', 120)
        && positiveCents(data().amountCents)
        && stamp(data().purchaseDate)
        && data().installmentsTotal is int
        && data().installmentsTotal >= 1 && data().installmentsTotal <= 48
        && data().installmentNumber is int
        && data().installmentNumber >= 1
        && data().installmentNumber <= data().installmentsTotal
        && optionalRef(userId, 'categories', 'categoryId')
        && optionalRef(userId, 'invoices', 'invoiceId')
        // compra nunca entra em fatura já paga/fechada (o pagamento é do servidor): a fatura (depois do lote) deve estar aberta
        && (!('invoiceId' in data()) || getAfter(docPath(userId, 'invoices', data().invoiceId)).data.status == 'open')
        && optionalRef(userId, 'debtors', 'debtorId')
        && optionalString('notes', 300)
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      // Compra lançada é imutável (valor/devedor/fatura não mudam depois). Compra de DEVEDOR só é excluída por
      // administrador ou depois que o devedor foi removido (preserva o que ele deve e os recebimentos dela).
      // Compra de fatura FECHADA/PAGA também não é apagada (o total a pagar é recalculado delas pelo servidor).
      allow delete: if isAdmin()
        || (isOwner(userId)
            && (!('debtorId' in resource.data) || !exists(docPath(userId, 'debtors', resource.data.debtorId)))
            && (!('invoiceId' in resource.data) || !exists(docPath(userId, 'invoices', resource.data.invoiceId))
                || get(docPath(userId, 'invoices', resource.data.invoiceId)).data.status in ['open', 'cancelled']));
    }

    // ---------- faturas ----------
    match /users/{userId}/invoices/{invoiceId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['cardId', 'referenceMonth', 'closingDate', 'dueDate', 'totalCents',
                   'paidCents', 'accountId', 'paidAt', 'status', 'createdAt', 'updatedAt'])
        && requiredOk(['cardId', 'referenceMonth', 'dueDate', 'status', 'createdAt', 'updatedAt'])
        && ref(userId, 'creditCards', 'cardId')
        && data().referenceMonth is string
        && data().referenceMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && optionalStamp('closingDate')
        && stamp(data().dueDate)
        && (!('totalCents' in data()) || cents(data().totalCents))
        && (!('paidCents' in data()) || cents(data().paidCents))
        && optionalRef(userId, 'accounts', 'accountId')
        && optionalStamp('paidAt')
        && oneOf('status', ['open', 'closed', 'paid', 'cancelled'])
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'))
        // Fatura PAGA é pagamento confirmado: valor, conta e data não mudam (nem a fatura volta de `paid`).
        && (resource == null || resource.data.status != 'paid')
        // VF-ARQ-02: o pagamento da fatura (status paid, paidCents, accountId, paidAt) é gravado só pela camada confiável.
        && data().status != 'paid'
        && !('paidCents' in data()) && !('accountId' in data()) && !('paidAt' in data());
      allow delete: if isAdmin()
        || (isOwner(userId)
            && (resource.data.status != 'paid' || !exists(docPath(userId, 'creditCards', resource.data.cardId)))
            && !exists(docPath(userId, 'reversals', 'invoices_' + invoiceId)));
    }

    // ---------- orçamentos ----------
    match /users/{userId}/budgets/{budgetId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && keysOk(['categoryId', 'month', 'limitCents', 'createdAt', 'updatedAt'])
        && requiredOk(['categoryId', 'month', 'limitCents', 'createdAt', 'updatedAt'])
        && ref(userId, 'categories', 'categoryId')
        && data().month is string
        && data().month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && positiveCents(data().limitCents)
        && data().updatedAt == request.time
        && (resource == null || immutable('createdAt'));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------- VF-ARQ-02: coleções gravadas SÓ pela camada confiável (o cliente apenas lê as próprias) ----------
    match /users/{userId}/reversals/{reversalId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /users/{userId}/operations/{operationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /users/{userId}/batches/{batchId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ---------- auditoria (imutável) ----------
    match /users/{userId}/auditLog/{entryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && keysOk(['action', 'entity', 'entityId', 'before', 'after', 'actorUid', 'createdAt'])
        && requiredOk(['action', 'entity', 'entityId', 'actorUid', 'createdAt'])
        && text('action', 60)
        // VF-SEC-07: ações do servidor têm formato `dominio.operacao` (ex.: transfer.create, data.clearOwn); o cliente não as imita.
        && !data().action.matches('.*[.].*')
        && text('entity', 60)
        && text('entityId', 128)
        && (!('before' in data()) || (data().before is map && data().before.size() <= 60))
        && (!('after' in data()) || (data().after is map && data().after.size() <= 60))
        && data().actorUid == request.auth.uid
        && data().createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- consulta de grupo de coleções (SOMENTE administrador, só leitura) ----------
    // Permite à limpeza global descobrir documentos de todos os usuários sem enumerar uids.
    match /{path=**}/accounts/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/categories/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/incomes/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/expenses/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/transfers/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/subscriptions/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/debtors/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/debts/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/debtPayments/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/goals/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/goalTransactions/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/creditCards/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/cardPurchases/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/invoices/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/reversals/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/batches/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/operations/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/budgets/{docId} {
      allow read: if isAdmin();
    }

    // ---------- negação padrão ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
