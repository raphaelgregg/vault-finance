{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(server|tests|docs|scripts)/:path*", "destination": "/", "permanent": false }
  ],
  "functions": {
    "api/finance.mjs": { "maxDuration": 30 },
    "api/validation.mjs": { "maxDuration": 60 },
    "api/docs.mjs": { "maxDuration": 10, "includeFiles": "docs/playbook/index.json" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-B7G0B23X1o+J0S5SWZj7sXl3EwB5RUOCMJrrLMiPDTI=' https://www.gstatic.com https://apis.google.com https://www.google.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://firebaseappcheck.googleapis.com; frame-src https://vault-finance-d1603.firebaseapp.com https://www.google.com/recaptcha/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/pages/dashboard" },
    { "source": "/bancos", "destination": "/pages/bancos" },
    { "source": "/categorias", "destination": "/pages/categorias" },
    { "source": "/receitas", "destination": "/pages/receitas" },
    { "source": "/despesas", "destination": "/pages/despesas" },
    { "source": "/transferencias", "destination": "/pages/transferencias" },
    { "source": "/orcamentos", "destination": "/pages/orcamentos" },
    { "source": "/assinaturas", "destination": "/pages/assinaturas" },
    { "source": "/devedores", "destination": "/pages/devedores" },
    { "source": "/metas", "destination": "/pages/metas" },
    { "source": "/cartoes", "destination": "/pages/cartoes" },
    { "source": "/relatorios", "destination": "/pages/relatorios" },
    { "source": "/configuracoes", "destination": "/pages/configuracoes" },
    { "source": "/manutencao-dados", "destination": "/pages/manutencao-dados" },
    { "source": "/playbook", "destination": "/pages/playbook" }
  ]
}
