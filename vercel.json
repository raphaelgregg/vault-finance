{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(server|tests|docs|scripts)/:path*", "destination": "/", "permanent": false }
  ],
  "functions": {
    "api/finance.mjs": { "maxDuration": 30 },
    "api/validation.mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-rcGAGZ3LarR9Gq4EJ0BErje+zWTEhFmKbcrEdWFU4O8=' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src https://vault-finance-d1603.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/pages/dashboard" },
    { "source": "/bancos", "destination": "/pages/bancos" },
    { "source": "/categorias", "destination": "/pages/categorias" },
    { "source": "/receitas", "destination": "/pages/receitas" },
    { "source": "/despesas", "destination": "/pages/despesas" },
    { "source": "/transferencias", "destination": "/pages/transferencias" },
    { "source": "/orcamentos", "destination": "/pages/orcamentos" },
    { "source": "/assinaturas", "destination": "/pages/assinaturas" },
    { "source": "/devedores", "destination": "/pages/devedores" },
    { "source": "/metas", "destination": "/pages/metas" },
    { "source": "/cartoes", "destination": "/pages/cartoes" },
    { "source": "/relatorios", "destination": "/pages/relatorios" },
    { "source": "/configuracoes", "destination": "/pages/configuracoes" },
    { "source": "/manutencao-dados", "destination": "/pages/manutencao-dados" }
  ]
}
